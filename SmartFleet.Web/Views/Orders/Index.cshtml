@model SmartFleet.ViewModel.OrderViewModel

@{
    ViewData["Title"] = "Orders";
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/order/list.css">
</head>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.CanCreateOrder)
{
    <p class="add-order">
        <a asp-action="Create" class="btn btn-add-car">
            <i class="fas fa-plus driver-icon"></i> Make Order
        </a>
    </p>
}

<div class="order-filter-bar">
    <form asp-action="Index" method="get" class="d-flex align-items-center flex-wrap gap-2 w-100">
        <!-- Admin-only filters -->
        @if (Model.IsAdminUser)
        {
            <div class="form-group mx-2">
                <input type="text" name="searchUserId" value="@Model.SearchUserId" class="form-control form-control-sm" placeholder="Search User name" />
            </div>
        }
        
        <!-- Regular filters (for all users) -->
        <div class="form-group mx-2">
            <input type="text" name="searchStartLocation" value="@Model.SearchStartLocation" class="form-control form-control-sm" placeholder="Start Location" />
        </div>
        <div class="form-group mx-2">
            <input type="text" name="searchDestination" value="@Model.SearchDestination" class="form-control form-control-sm" placeholder="Destination" />
        </div>
        
        <!-- Select filters (grouped together) -->
        <div class="form-group mx-2">
            <select name="stateFilter" class="form-control form-control-sm">
                <option value="">All Statuses</option>
                @foreach (SmartFleet.Models.OrderState state in Enum.GetValues(typeof(SmartFleet.Models.OrderState)))
                {
                    <option value="@state" selected="@(Model.StateFilter == state ? "selected" : null)">@state</option>
                }
            </select>
        </div>
        @if (Model.IsAdminUser)
        {
            <div class="form-group mx-2">
                <select name="typeFilter" class="form-control form-control-sm">
                    <option value="">All Types</option>
                    @foreach (SmartFleet.Models.VehicleType type in Enum.GetValues(typeof(SmartFleet.Models.VehicleType)))
                    {
                        <option value="@type" selected="@(Model.TypeFilter == type ? "selected" : null)">@type</option>
                    }
                </select>
            </div>
        }
        
        <!-- Date range filters (for all users) -->
        <div class="form-group mx-2">
            <label for="startDate" class="form-label">From:</label>
            <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="form-group mx-2">
            <label for="endDate" class="form-label">To:</label>
            <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="order-filter-actions">
            <button type="submit" class="btn btn-sm custom-btn">
                <i class="fas fa-filter"></i> Filter
            </button>
            <a asp-action="Index" class="btn btn-sm btn-secondary ms-2">Clear</a>
        </div>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-order table-bordered">
        <thead>
            <tr>
                @if (Model.IsAdminUser)
                {
                    <th>Created By</th>
                }
                <th>Vehicle Type</th>
                <th>Passengers</th>
                <th>Destination</th>
                <th>Start Date</th>
                <th>End Date</th>
                @if (Model.IsCommissioner || Model.IsFleetManager)
                {
                    <th>Resources Availability</th>
                }
                <th>Status</th>
                <th>Created At</th>
                <th style="width: 300px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Orders)
            {
                <tr>
                    @if (Model.IsAdminUser)
                    {
                        <td>@item.User.UserName</td>
                    }
                    <td>@item.VehicleType</td>
                    <td>@item.PassengerCount</td>
                    <td>@item.Destination</td>
                    <td>@item.TripStartDate.ToShortDateString()</td>
                    <td>@item.TripEndDate.ToShortDateString()</td>
                    @if (Model.IsCommissioner || Model.IsFleetManager)
                    {
                        <td>
                            @if (item.Status == SmartFleet.Models.OrderState.Pending)
                            {
                                if (Model.ResourceAvailability != null && Model.ResourceAvailability.ContainsKey(item.Id))
                                {
                                    var avail = Model.ResourceAvailability[item.Id];
                                    if (avail == "Available")
                                    {
                                        <span class="badge" style="background:#eafaf1; color:#4e944f; border:1px solid #4e944f; font-weight:500;"><i class="fas fa-check-circle"></i> Available</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:#fff4e5; color:#b26a00; border:1px solid #b26a00; font-weight:500;"><i class="fas fa-times-circle"></i> Not Available</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Unknown</span>
                                }
                            }
                            else if (item.Status == SmartFleet.Models.OrderState.Approved && item.Trip == null)
                            {
                                if (Model.ResourceAvailability != null && Model.ResourceAvailability.ContainsKey(item.Id))
                                {
                                    var avail = Model.ResourceAvailability[item.Id];
                                    if (avail == "Available")
                                    {
                                        <span class="badge" style="background:#eafaf1; color:#4e944f; border:1px solid #4e944f; font-weight:500;"><i class="fas fa-check-circle"></i> Available</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:#fff4e5; color:#b26a00; border:1px solid #b26a00; font-weight:500;"><i class="fas fa-times-circle"></i> Not Available</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Unknown</span>
                                }
                            }
                            else
                            {
                                <span class="badge bg-secondary">N/A</span>
                            }
                        </td>
                    }
                    <td>
                        <span class="badge-status badge-@item.Status.ToString().ToLower()">
                            @item.Status
                        </span>
                    </td>
                    <td>@item.CreatedAt.ToShortDateString()</td>
                    <td>
                        @if (Model.IsCommissioner)
                        {
                            @if (item.Status == SmartFleet.Models.OrderState.Pending)
                            {
                                <form asp-action="Approve" asp-route-id="@item.Id" method="post" style="display: inline;">
                                    <button type="submit" class="btn btn-approve" onclick="return confirm('Are you sure you want to approve this order?')">
                                        <i class="fas fa-check"></i> Approve
                                    </button>
                                </form>
                                <form asp-action="Reject" asp-route-id="@item.Id" method="post" style="display: inline;">
                                    <button type="submit" class="btn btn-reject" onclick="return confirm('Are you sure you want to reject this order?')">
                                        <i class="fas fa-times"></i> Reject
                                    </button>
                                </form>
                            }
                        }
                        else if (Model.IsFleetManager)
                        {
                            @if (item.Status == SmartFleet.Models.OrderState.Approved)
                            {
                                @if (item.Trip != null)
                                {
                                    <span class="btn btn-trip-created disabled">
                                        <i class="fas fa-check-circle"></i> Trip Created
                                    </span>
                                }
                                else
                                {
                                    <a asp-controller="Trips" asp-action="Create" asp-route-id="@item.Id" asp-route-userId="@item.UserId" class="btn btn-create-trip">
                                        <i class="fas fa-route"></i> Create Trip
                                    </a>
                                }
                            }
                        }
                        else if (Model.IsSysSupport)
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-edit">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-details">
                                <i class="fas fa-info-circle"></i> Details
                            </a>
                            @if (item.Status == SmartFleet.Models.OrderState.Pending && item.UserId == Model.CurrentUserId)
                            {
                                <form asp-action="Cancel" asp-route-id="@item.Id" method="post" style="display: inline;">
                                    <button type="submit" class="btn btn-cancel" onclick="return confirm('Are you sure you want to cancel this order?')">
                                        <i class="fas fa-times"></i> Cancel
                                    </button>
                                </form>
                            }
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-delete">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        }
                        else
                        {
                            @if (item.Status == SmartFleet.Models.OrderState.Pending)
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-edit">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                            }
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-details">
                                <i class="fas fa-info-circle"></i> Details
                            </a>
                            @if (item.Status == SmartFleet.Models.OrderState.Pending)
                            {
                                <form asp-action="Cancel" asp-route-id="@item.Id" method="post" style="display: inline;">
                                    <button type="submit" class="btn btn-cancel" onclick="return confirm('Are you sure you want to cancel this order?')">
                                        <i class="fas fa-times" style="color: white;!important"></i> <span style="color: white;!important">Cancel</span>
                                    </button>
                                </form>
                            }
                        }
                        
                        <!-- PDF Download Button - Available for all users -->
                        <button type="button" 
                                class="btn btn-pdf-download" 
                                onclick="downloadOrderPdf(this)"
                                data-order-id="@item.Id"
                                data-vehicle-type="@item.VehicleType"
                                data-passenger-count="@item.PassengerCount"
                                data-start-location="@item.StartLocation"
                                data-destination="@item.Destination"
                                data-reason="@(item.Reason ?? "General Transport")"
                                data-trip-start="@item.TripStartDate.ToString("yyyy-MM-ddTHH:mm")"
                                data-trip-end="@item.TripEndDate.ToString("yyyy-MM-ddTHH:mm")"
                                title="Download PDF">
                            <i class="fas fa-file-pdf"></i> PDF
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination Controls -->
@if (ViewBag.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new {
                        pageNumber = i,
                        searchUserId = ViewBag.SearchUserId,
                        searchStartLocation = ViewBag.SearchStartLocation,
                        searchDestination = ViewBag.SearchDestination,
                        typeFilter = ViewBag.TypeFilter,
                        stateFilter = ViewBag.StateFilter,
                        startDate = ViewBag.StartDate,
                        endDate = ViewBag.EndDate
                    })">
                        @i
                    </a>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script>
        function downloadOrderPdf(button) {
            // Get data from button attributes
            const orderId = button.getAttribute('data-order-id');
            const vehicleType = button.getAttribute('data-vehicle-type');
            const passengerCount = button.getAttribute('data-passenger-count');
            const startLocation = button.getAttribute('data-start-location');
            const destination = button.getAttribute('data-destination');
            const reason = button.getAttribute('data-reason') || 'General Transport';
            const tripStartDate = button.getAttribute('data-trip-start');
            const tripEndDate = button.getAttribute('data-trip-end');

            // Show loading state
            const originalText = button.innerHTML;
            button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';
            button.disabled = true;

            // Add timeout to reset button if PDF generation takes too long
            const timeoutId = setTimeout(() => {
                button.innerHTML = originalText;
                button.disabled = false;
                alert('PDF generation timed out. Please try again.');
            }, 10000); // 10 seconds timeout

            try {
                // Use a simpler approach with jsPDF text methods
                const { jsPDF } = window.jspdf;
                const doc = new jsPDF();
                
                // Set font
                doc.setFont("times", "normal");
                
                let yPosition = 30;
                
                // Header
                doc.setFontSize(18);
                doc.setFont("times", "bold");
                doc.text("SMART FLEET", 105, yPosition, { align: 'center' });
                
                yPosition += 8;
                doc.setFontSize(14);
                doc.setFont("times", "normal");
                doc.text("Transport Order", 105, yPosition, { align: 'center' });
                
                yPosition += 10;
                doc.setFontSize(10);
                doc.text(`Date: ${new Date().toLocaleDateString('en-US')}`, 105, yPosition, { align: 'center' });
                
                yPosition += 5;
                doc.text(`Order ID: ${orderId}`, 105, yPosition, { align: 'center' });
                
                yPosition += 20;
                
                // Order Details
                doc.setFontSize(12);
                doc.setFont("times", "bold");
                doc.text("Order Details", 20, yPosition);
                doc.line(20, yPosition + 2, 80, yPosition + 2);
                
                yPosition += 10;
                doc.setFontSize(10);
                doc.setFont("times", "normal");
                
                const details = [
                    ['Passenger Count:', `${passengerCount} passengers`],
                    ['Start Location:', startLocation],
                    ['Destination:', destination],
                    ['Trip Start:', new Date(tripStartDate).toLocaleString('en-US')],
                    ['Trip End:', new Date(tripEndDate).toLocaleString('en-US')],
                    ['Vehicle Type:', vehicleType],
                    ['Reason:', reason]
                ];
                
                details.forEach(([label, value]) => {
                    doc.setFont("times", "bold");
                    doc.text(label, 25, yPosition);
                    doc.setFont("times", "normal");
                    doc.text(value, 70, yPosition);
                    yPosition += 8;
                });
                
                yPosition += 10;
                
                // Terms & Conditions
                doc.setFontSize(12);
                doc.setFont("times", "bold");
                doc.text("Terms & Conditions", 20, yPosition);
                doc.line(20, yPosition + 2, 90, yPosition + 2);
                
                yPosition += 10;
                doc.setFontSize(10);
                doc.setFont("times", "normal");
                
                const terms = [
                    "1. Must comply with scheduled trip times",
                    "2. Smoking is prohibited inside the vehicle",
                    "3. Must respect traffic laws and regulations",
                    "4. Passenger is responsible for personal belongings",
                    "5. Company reserves the right to cancel trips in emergencies"
                ];
                
                terms.forEach(term => {
                    doc.text(term, 25, yPosition);
                    yPosition += 8;
                });
                
                yPosition += 15;
                
                // Signatures
                doc.setFontSize(12);
                doc.setFont("times", "bold");
                doc.text("Signatures", 105, yPosition, { align: 'center' });
                doc.line(70, yPosition + 2, 140, yPosition + 2);
                
                yPosition += 20;
                
                // Signature boxes
                doc.rect(30, yPosition, 60, 25);
                doc.rect(120, yPosition, 60, 25);
                
                doc.setFontSize(10);
                doc.setFont("times", "bold");
                doc.text("Customer Signature", 60, yPosition + 30, { align: 'center' });
                doc.text("Company Representative", 150, yPosition + 30, { align: 'center' });
                
                doc.setFont("times", "normal");
                doc.text("Date: _______________", 60, yPosition + 35, { align: 'center' });
                doc.text("Date: _______________", 150, yPosition + 35, { align: 'center' });
                
                // Footer
                yPosition += 50;
                doc.setFontSize(9);
                doc.line(20, yPosition, 190, yPosition);
                yPosition += 8;
                doc.text("This document was automatically generated by Smart Fleet System", 105, yPosition, { align: 'center' });
                yPosition += 5;
                doc.text("Contact: info@smartfleet.com | Phone: +1-234-567-8900", 105, yPosition, { align: 'center' });
                
                // Clear timeout and download
                clearTimeout(timeoutId);
                
                // Download the PDF
                const fileName = `Order_${orderId}_${new Date().toISOString().split('T')[0]}.pdf`;
                doc.save(fileName);
                
                // Reset button state
                button.innerHTML = originalText;
                button.disabled = false;

            } catch (error) {
                clearTimeout(timeoutId);
                console.error('Error generating PDF:', error);
                alert('Error generating PDF. Please try again.');
                
                // Reset button state
                button.innerHTML = originalText;
                button.disabled = false;
            }
        }
    </script>
}
