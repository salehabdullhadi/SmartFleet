@model SmartFleet.Models.Order

@{
    ViewData["Title"] = "Edit Order";
}

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/order/edit.css">
</head>

<div class="edit-layout-container">
    <div class="edit-form-wrapper">
        <!-- Navigation Back Button -->
        <div class="edit-navigation">
            <a asp-action="Index" class="edit-back-link">
                <i class="fas fa-arrow-left"></i> Back to Orders
            </a>
        </div>

        <!-- Heading -->
        <h1 class="edit-heading">
            <i class="fas fa-edit"></i> Edit Order
        </h1>

        <!-- Form -->
        <form asp-action="Edit" class="edit-custom-form needs-validation" novalidate>
            <div asp-validation-summary="All" class="edit-validation-message alert alert-danger" role="alert"></div>
            <input type="hidden" asp-for="Id" />

            <!-- Order Information Section -->
            <div class="edit-section">
                <h3 class="section-title">
                    <i class="fas fa-file-alt"></i> Order Information
                </h3>
                
                <!-- Row 1: User and Vehicle Type -->
                <div class="edit-input-row">
                    <div class="edit-input-col">
                        <div class="edit-input-group">
                            <label asp-for="UserId" class="edit-input-label">
                                <i class="fas fa-user"></i> User *
                            </label>
                            <select asp-for="UserId" class="edit-dropdown" asp-items="ViewBag.UserId" required>
                                <option value="">-- Select User --</option>
                            </select>
                            <span asp-validation-for="UserId" class="edit-validation-message"></span>
                            <small class="form-text text-muted">Select the user who made this order</small>
                        </div>
                    </div>
                    <div class="edit-input-col">
                        <div class="edit-input-group">
                            <label asp-for="VehicleType" class="edit-input-label">
                                <i class="fas fa-truck"></i> Vehicle Type *
                            </label>
                            <select asp-for="VehicleType" class="edit-dropdown" required>
                                <option value="">-- Select Vehicle Type --</option>
                                @foreach (SmartFleet.Models.VehicleType type in Enum.GetValues(typeof(SmartFleet.Models.VehicleType)))
                                {
                                    <option value="@type" selected="@(Model.VehicleType == type ? "selected" : null)">@type</option>
                                }
                            </select>
                            <span asp-validation-for="VehicleType" class="edit-validation-message"></span>
                            <small class="form-text text-muted">Type of vehicle required for this order</small>
                        </div>
                    </div>
                </div>

                <!-- Row 2: Passenger Count and Start Location -->
                <div class="edit-input-row">
                    <div class="edit-input-col">
                        <div class="edit-input-group">
                            <label asp-for="PassengerCount" class="edit-input-label">
                                <i class="fas fa-users"></i> Passenger Count *
                            </label>
                            <input asp-for="PassengerCount" class="edit-input-field" type="number" min="1" max="50" required />
                            <span asp-validation-for="PassengerCount" class="edit-validation-message"></span>
                            <small class="form-text text-muted">Number of passengers for this trip</small>
                        </div>
                    </div>
                    <div class="edit-input-col">
                        <div class="edit-input-group">
                            <label asp-for="StartLocation" class="edit-input-label">
                                <i class="fas fa-map-marker-alt"></i> Start Location *
                            </label>
                            <input asp-for="StartLocation" class="edit-input-field" required />
                            <span asp-validation-for="StartLocation" class="edit-validation-message"></span>
                            <small class="form-text text-muted">Starting point of the journey</small>
                        </div>
                    </div>
                </div>

                <!-- Row 3: Destination and Reason -->
                <div class="edit-input-row">
                    <div class="edit-input-col">
                        <div class="edit-input-group">
                            <label asp-for="Destination" class="edit-input-label">
                                <i class="fas fa-flag-checkered"></i> Destination *
                            </label>
                            <input asp-for="Destination" class="edit-input-field" required />
                            <span asp-validation-for="Destination" class="edit-validation-message"></span>
                            <small class="form-text text-muted">Final destination of the journey</small>
                        </div>
                    </div>
                    <div class="edit-input-col">
                        <div class="edit-input-group">
                            <label asp-for="Reason" class="edit-input-label">
                                <i class="fas fa-comment"></i> Reason
                            </label>
                            <input asp-for="Reason" class="edit-input-field" />
                            <span asp-validation-for="Reason" class="edit-validation-message"></span>
                            <small class="form-text text-muted">Purpose or reason for this trip</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Trip Schedule Section -->
            <div class="edit-section">
                <h3 class="section-title">
                    <i class="fas fa-calendar-alt"></i> Trip Schedule
                </h3>
                
                <!-- Row 4: Start and End Dates -->
                <div class="edit-input-row">
                    <div class="edit-input-col">
                        <div class="edit-input-group">
                            <label asp-for="TripStartDate" class="edit-input-label">
                                <i class="fas fa-play-circle"></i> Start Date & Time *
                            </label>
                            <input asp-for="TripStartDate" class="edit-input-field" type="datetime-local" required />
                            <span asp-validation-for="TripStartDate" class="edit-validation-message"></span>
                            <small class="form-text text-muted">When the trip should begin</small>
                        </div>
                    </div>
                    <div class="edit-input-col">
                        <div class="edit-input-group">
                            <label asp-for="TripEndDate" class="edit-input-label">
                                <i class="fas fa-stop-circle"></i> End Date & Time *
                            </label>
                            <input asp-for="TripEndDate" class="edit-input-field" type="datetime-local" required />
                            <span asp-validation-for="TripEndDate" class="edit-validation-message"></span>
                            <small class="form-text text-muted">When the trip should end</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Status Section -->
            <div class="edit-section">
                <h3 class="section-title">
                    <i class="fas fa-info-circle"></i> Order Status
                </h3>
                
                <!-- Row 5: Status and Created Date -->
                <div class="edit-input-row">
                    <div class="edit-input-col">
                        <div class="edit-input-group">
                            <label asp-for="Status" class="edit-input-label">
                                <i class="fas fa-tasks"></i> Status *
                            </label>
                            <select asp-for="Status" class="edit-dropdown" required>
                                <option value="">-- Select Status --</option>
                                @foreach (SmartFleet.Models.OrderState state in Enum.GetValues(typeof(SmartFleet.Models.OrderState)))
                                {
                                    <option value="@state" selected="@(Model.Status == state ? "selected" : null)">@state</option>
                                }
                            </select>
                            <span asp-validation-for="Status" class="edit-validation-message"></span>
                            <small class="form-text text-muted">Current status of this order</small>
                        </div>
                    </div>
                    <div class="edit-input-col">
                        <div class="edit-input-group">
                            <label asp-for="CreatedAt" class="edit-input-label">
                                <i class="fas fa-clock"></i> Created Date
                            </label>
                            <input asp-for="CreatedAt" class="edit-input-field" type="datetime-local" readonly />
                            <span asp-validation-for="CreatedAt" class="edit-validation-message"></span>
                            <small class="form-text text-muted">When this order was originally created</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Information Box -->
            <div class="edit-info-box">
                <div class="info-icon">
                    <i class="fas fa-info-circle"></i>
                </div>
                <div class="info-content">
                    <h4>Important Notes</h4>
                    <ul>
                        <li>Changing the trip dates may affect existing trip assignments</li>
                        <li>Status changes will be logged for audit purposes</li>
                        <li>All required fields are marked with an asterisk (*)</li>
                    </ul>
                </div>
            </div>

            <!-- Submit Buttons -->
            <div class="edit-button-group">
                <button type="button" class="edit-secondary-button" onclick="resetForm()">
                    <i class="fas fa-undo"></i> Reset Form
                </button>
                <button type="submit" class="edit-primary-button" id="submitBtn">
                    <i class="fas fa-save"></i> Update Order
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Enhanced form validation and user experience
        $(document).ready(function() {
            const form = $('.edit-custom-form');
            const submitBtn = $('#submitBtn');
            
            // Real-time validation feedback
            $('.edit-dropdown, .edit-input-field').on('change input', function() {
                validateField($(this));
            });
            
            // Form submission handling
            form.on('submit', function(e) {
                console.log('Form submission started');
                
                if (!validateForm()) {
                    e.preventDefault();
                    console.log('Form validation failed');
                    showValidationMessage('Please correct the errors below.', 'error');
                    return false;
                }
                
                console.log('Form validation passed, submitting...');
                
                // Show loading state
                submitBtn.prop('disabled', true)
                    .html('<i class="fas fa-spinner fa-spin"></i> Updating Order...');
                
                // Re-enable after 5 seconds as fallback
                setTimeout(() => {
                    submitBtn.prop('disabled', false)
                        .html('<i class="fas fa-save"></i> Update Order');
                }, 5000);
            });
            
            // Initialize tooltips for better UX
            $('[data-toggle="tooltip"]').tooltip();
        });
        
        function validateField(field) {
            const value = field.val();
            const fieldName = field.attr('name');
            const validationSpan = field.siblings('.edit-validation-message');
            
            // Remove existing validation classes
            field.removeClass('is-valid is-invalid');
            
            if (field.prop('required') && (!value || value.trim() === '')) {
                field.addClass('is-invalid');
                validationSpan.text('This field is required.');
                return false;
            } else {
                field.addClass('is-valid');
                validationSpan.text('');
                return true;
            }
        }
        
        function validateForm() {
            let isValid = true;
            
            // Validate all required fields
            $('.edit-dropdown[required], .edit-input-field[required]').each(function() {
                if (!validateField($(this))) {
                    isValid = false;
                }
            });
            
            return isValid;
        }
        
        function resetForm() {
            if (confirm('Are you sure you want to reset the form? All changes will be lost.')) {
                $('.edit-custom-form')[0].reset();
                $('.edit-dropdown, .edit-input-field').removeClass('is-valid is-invalid');
                $('.edit-validation-message').text('');
                showValidationMessage('Form has been reset.', 'success');
            }
        }
        
        function showValidationMessage(message, type) {
            const alertClass = type === 'error' ? 'alert-danger' : 'alert-success';
            const alertHtml = `
                <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            
            $('.edit-validation-message').first().after(alertHtml);
            
            // Auto-dismiss success messages
            if (type === 'success') {
                setTimeout(() => {
                    $('.alert-success').fadeOut();
                }, 3000);
            }
        }
    </script>
}
