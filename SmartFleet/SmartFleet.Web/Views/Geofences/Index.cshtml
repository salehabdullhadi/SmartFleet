@model IEnumerable<SmartFleet.Models.Geofence>
@using SmartFleet.Models;
@{
    ViewData["Title"] = "Geofences";
}
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<link rel="stylesheet" href="/css/pages/vehicle/list.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="/css/pages/geofence/index.css" />

<div class="container my-4 d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    @Html.AntiForgeryToken()
    <div class="card shadow-sm rounded-4 p-4 w-100" style="background: #fff; max-width: 1200px; margin: 0 auto;">
        <h1 class="mb-4 text-center" style="font-family: 'Montserrat', 'Lato', Arial, sans-serif; font-weight: 600; font-size: 2rem; color: #222;">Geofences</h1>
        <div class="d-flex flex-row justify-content-end align-items-center mb-3 gap-3">
            <a asp-action="Create" class="btn btn-add-car ms-md-auto"><i class="fas fa-plus"></i> Add Geofence</a>
        </div>
        <div class="table-responsive">
            <table id="geofence-table" class="table table-bordered align-middle text-center" style="border-radius: 15px; background: #fff;">
                <thead class="table-light">
                    <tr>
                        <th class="text-center align-middle">Name</th>
                        <th class="text-center align-middle">Type</th>
                        <th class="text-center align-middle">Shape</th>
                        <th class="text-center align-middle">Preview</th>
                        <th class="text-center align-middle" style="width: 260px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    var isCircle = item.Type == GeofenceType.Circle;
                    var isPolygon = item.Type == GeofenceType.Polygon;
                    var mapId = $"map-preview-{item.Id}";
                    <tr>
                        <td class="align-middle text-center" style="font-weight: 600; color: #222;">
                            @item.Name
                            @if (item.IsDefault)
                            {
                                <span class="badge bg-warning text-dark ms-2"><i class="fas fa-star"></i> Default</span>
                            }
                        </td>
                        <td class="align-middle text-center">
                            <span class="badge badge-status @(isCircle ? "badge-available" : "badge-on_trip")" style="font-size:1em;">@item.Type</span>
                        </td>
                        <td class="align-middle text-center">
                            @if (isCircle)
                            {
                                <span>Center: @item.CenterLat, @item.CenterLng<br />Radius: @item.RadiusMeters m</span>
                            }
                            else if (isPolygon && !string.IsNullOrEmpty(item.PolygonJson))
                            {
                                var points = Newtonsoft.Json.JsonConvert.DeserializeObject<List<List<double>>>(item.PolygonJson);
                                <span>Polygon with @points.Count points</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td class="align-middle text-center" style="width: 120px;">
                            <div id="@mapId" style="height: 80px; width: 110px; cursor:pointer; border-radius:8px; border:1px solid #eee; margin: 0 auto;" data-bs-toggle="modal" data-bs-target="#modal-@item.Id"></div>
                            <!-- Modal for larger preview -->
                            <div class="modal fade" id="modal-@item.Id" tabindex="-1" aria-labelledby="modalLabel-@item.Id" aria-hidden="true">
                              <div class="modal-dialog modal-fullscreen modal-dialog-centered">
                                <div class="modal-content">
                                  <div class="modal-header">
                                    <h5 class="modal-title" id="modalLabel-@item.Id">@item.Name - Preview</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                  </div>
                                  <div class="modal-body p-0" style="height: 100vh; width: 100vw;">
                                    <div id="modal-map-@item.Id" style="height: 100vh; width: 100vw;"></div>
                                  </div>
                                </div>
                              </div>
                            </div>
                        </td>
                        <td class="align-middle text-center" style="width: 260px;">
                            <div class="d-flex justify-content-center align-items-center gap-1 flex-nowrap ms-3" style="margin-left: 18px;">
                               <a asp-action="Assign" asp-route-id="@item.Id" class="geofence-action-btn geofence-action-assign" title="Assign Vehicles">
                                    <i class="fas fa-truck me-1"></i> <span>Assign</span>
                                </a>
                               
                                <a asp-action="Edit" asp-route-id="@item.Id" class="geofence-action-btn geofence-action-edit" title="Edit">
                                    <i class="fas fa-edit me-1"></i> <span>Edit</span>
                                </a>
                                <button onclick="confirmDelete(@item.Id, '@item.Name')" class="geofence-action-btn geofence-action-delete" title="Delete" type="button">
                                    <i class="fas fa-trash-alt deleted_icon me-1"></i> <span>Delete</span>
                                </button>
                              
                            </div>
                        </td>
                    </tr>
                    <script>
                        document.addEventListener("DOMContentLoaded", function () {
                            var map = L.map('@mapId', { zoomControl: false, attributionControl: false, dragging: false, scrollWheelZoom: false, doubleClickZoom: false, boxZoom: false, keyboard: false }).setView([@item.CenterLat, @item.CenterLng], 14);
                            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);
                            @if (isCircle)
                            {
                                <text>
                                L.circle([
                                    @item.CenterLat, @item.CenterLng
                                ], {
                                    radius: @item.RadiusMeters,
                                    color: 'blue',
                                    fillColor: '#3f8efc',
                                    fillOpacity: 0.2
                                }).addTo(map);
                                </text>
                            }
                            else if (isPolygon && !string.IsNullOrEmpty(item.PolygonJson))
                            {
                                <text>
                                var polygon = @Html.Raw(item.PolygonJson);
                                L.polygon(polygon, {
                                    color: 'green',
                                    fillColor: '#4caf50',
                                    fillOpacity: 0.2
                                }).addTo(map);
                                map.fitBounds(L.polygon(polygon).getBounds());
                                </text>
                            }
                            map.touchZoom.disable();
                            map.doubleClickZoom.disable();
                            map.scrollWheelZoom.disable();
                            map.boxZoom.disable();
                            map.keyboard.disable();
                            map.dragging.disable();
                        });
                        // Modal map
                        document.addEventListener("shown.bs.modal", function (event) {
                            var modal = event.target;
                            if (modal.id === "modal-@item.Id") {
                                setTimeout(function () {
                                    var modalMap = L.map('modal-map-@item.Id').setView([@item.CenterLat, @item.CenterLng], 15);
                                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(modalMap);
                                    @if (isCircle)
                                    {
                                        <text>
                                        L.circle([
                                            @item.CenterLat, @item.CenterLng
                                        ], {
                                            radius: @item.RadiusMeters,
                                            color: 'blue',
                                            fillColor: '#3f8efc',
                                            fillOpacity: 0.2
                                        }).addTo(modalMap);
                                        </text>
                                    }
                                    else if (isPolygon && !string.IsNullOrEmpty(item.PolygonJson))
                                    {
                                        <text>
                                        var polygon = @Html.Raw(item.PolygonJson);
                                        L.polygon(polygon, {
                                            color: 'green',
                                            fillColor: '#4caf50',
                                            fillOpacity: 0.2
                                        }).addTo(modalMap);
                                        modalMap.fitBounds(L.polygon(polygon).getBounds());
                                        </text>
                                    }
                                    modalMap.invalidateSize();
                                }, 300);
                            }
                        });
                    </script>
                }
                </tbody>
            </table>
        </div>
        <!-- Pagination Controls -->
        @if (ViewBag.TotalPages > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { pageNumber = i })">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>

<!-- Delete Confirmation Dialog -->
<div id="deleteConfirmationDialog" class="delete-dialog-overlay" style="display: none;">
    <div class="delete-dialog">
        <h3 class="delete-dialog-title">Delete Geofence</h3>
        <p class="delete-dialog-message">
            ARE YOU SURE YOU WANT TO DELETE THIS GEOFENCE?
        </p>
        <div class="delete-dialog-geofence-info">
            <div id="deleteGeofenceName"></div>
        </div>
        <div class="delete-dialog-buttons">
            <button type="button" id="confirmDeleteBtn" class="delete-dialog-btn delete-btn">Delete</button>
            <button type="button" id="cancelDeleteBtn" class="delete-dialog-btn cancel-btn">Cancel</button>
        </div>
    </div>
</div>

<!-- Force Delete Confirmation Dialog -->
<div id="forceDeleteConfirmationDialog" class="delete-dialog-overlay" style="display: none;">
    <div class="delete-dialog">
        <h3 class="delete-dialog-title">⚠️ Geofence Has Assigned Vehicles</h3>
        <p class="delete-dialog-message" id="forceDeleteMessage">
        </p>
        <div class="delete-dialog-geofence-info">
            <div style="color: #e67e22; font-weight: 600;">
                <i class="fas fa-exclamation-triangle"></i> 
                This will unassign all vehicles and delete the geofence permanently.
            </div>
        </div>
        <div class="delete-dialog-buttons">
            <button type="button" id="confirmForceDeleteBtn" class="delete-dialog-btn delete-btn">
                <i class="fas fa-trash"></i> Yes, Delete & Unassign
            </button>
            <button type="button" id="cancelForceDeleteBtn" class="delete-dialog-btn cancel-btn">Cancel</button>
        </div>
    </div>
</div>

<style>
.delete-dialog-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    z-index: 10000;
    display: flex;
    justify-content: center;
    align-items: center;
}

.delete-dialog {
    background: white;
    border-radius: 12px;
    padding: 30px;
    max-width: 450px;
    width: 90%;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    text-align: center;
}

.delete-dialog-title {
    color: #2c3e50;
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 15px;
    font-family: 'Montserrat', sans-serif;
}

.delete-dialog-message {
    color: #555;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 20px;
    line-height: 1.5;
}

.delete-dialog-geofence-info {
    background: #f8f9fa;
    border-radius: 8px;
    padding: 15px;
    margin-bottom: 25px;
    border-left: 4px solid #e74c3c;
}

#deleteGeofenceName {
    font-weight: 600;
    color: #2c3e50;
    font-size: 16px;
}

.delete-dialog-buttons {
    display: flex;
    gap: 15px;
    justify-content: center;
}

.delete-dialog-btn {
    padding: 12px 25px;
    border: none;
    border-radius: 25px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 14px;
    min-width: 100px;
}

.delete-btn {
    background: #e74c3c;
    color: white;
}

.delete-btn:hover {
    background: #c0392b;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(231, 76, 60, 0.4);
}

.cancel-btn {
    background: #95a5a6;
    color: white;
}

.cancel-btn:hover {
    background: #7f8c8d;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(149, 165, 166, 0.4);
}
</style>

<script>
let deleteGeofenceId = null;

function confirmDelete(geofenceId, geofenceName) {
    deleteGeofenceId = geofenceId;
    document.getElementById('deleteGeofenceName').textContent = geofenceName;
    document.getElementById('deleteConfirmationDialog').style.display = 'flex';
}

function hideDeleteDialog() {
    document.getElementById('deleteConfirmationDialog').style.display = 'none';
    deleteGeofenceId = null;
}

function showForceDeleteDialog(geofenceId, assignedCount, message) {
    deleteGeofenceId = geofenceId;
    document.getElementById('forceDeleteMessage').textContent = message;
    document.getElementById('forceDeleteConfirmationDialog').style.display = 'flex';
}

function hideForceDeleteDialog() {
    document.getElementById('forceDeleteConfirmationDialog').style.display = 'none';
    deleteGeofenceId = null;
}

function forceDeleteGeofence() {
    if (!deleteGeofenceId) return;
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    
    console.log('Sending force delete request for geofence ID:', deleteGeofenceId);
    
    fetch('/Geofences/DeleteGeofenceAjax', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded'
        },
        body: new URLSearchParams({
            'id': deleteGeofenceId,
            'forceDelete': 'true',
            '__RequestVerificationToken': token
        })
    })
    .then(response => {
        console.log('Response status:', response.status);
        return response.json();
    })
    .then(data => {
        console.log('Response data:', data);
        if (data.success) {
            alert(data.message);
            location.reload();
        } else {
            alert('Error: ' + data.message);
        }
        hideForceDeleteDialog();
    })
    .catch(error => {
        console.error('Error:', error);
        alert('An error occurred while deleting the geofence: ' + error.message);
        hideForceDeleteDialog();
    });
}

function deleteGeofence() {
    if (!deleteGeofenceId) return;
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    
    fetch('/Geofences/DeleteGeofenceAjax', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded'
        },
        body: new URLSearchParams({
            'id': deleteGeofenceId,
            '__RequestVerificationToken': token
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Success: Reload the page to see changes
            alert(data.message);
            location.reload();
        } else if (data.hasAssignedVehicles) {
            // Show force delete confirmation
            hideDeleteDialog();
            showForceDeleteDialog(deleteGeofenceId, data.assignedCount, data.message);
        } else {
            // Error: Show error message
            alert('Error: ' + data.message);
            hideDeleteDialog();
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('An error occurred while deleting the geofence.');
        hideDeleteDialog();
    });
}

// Event listeners
document.addEventListener('DOMContentLoaded', function() {
    // Regular delete dialog
    document.getElementById('confirmDeleteBtn').addEventListener('click', deleteGeofence);
    document.getElementById('cancelDeleteBtn').addEventListener('click', hideDeleteDialog);
    
    // Force delete dialog
    document.getElementById('confirmForceDeleteBtn').addEventListener('click', forceDeleteGeofence);
    document.getElementById('cancelForceDeleteBtn').addEventListener('click', hideForceDeleteDialog);
    
    // Close dialog when clicking outside
    document.getElementById('deleteConfirmationDialog').addEventListener('click', function(e) {
        if (e.target === this) {
            hideDeleteDialog();
        }
    });
    
    document.getElementById('forceDeleteConfirmationDialog').addEventListener('click', function(e) {
        if (e.target === this) {
            hideForceDeleteDialog();
        }
    });
    
    // Close dialog with Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            if (document.getElementById('deleteConfirmationDialog').style.display === 'flex') {
                hideDeleteDialog();
            } else if (document.getElementById('forceDeleteConfirmationDialog').style.display === 'flex') {
                hideForceDeleteDialog();
            }
        }
    });
});
</script> 